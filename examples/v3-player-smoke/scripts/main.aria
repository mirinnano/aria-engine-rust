aria;

// Presentation layout belongs to the package's DOM/CSS frontend. This smoke
// story exercises only the semantic screen route.
entry start;

// The launch check needs a player that stays open, so the story waits for
// the reader instead of ending (a finished story closes the player).
scene start {
  background asset("#07131f");
  narrate "起動の確認。";
  await advance;
  end;
}
