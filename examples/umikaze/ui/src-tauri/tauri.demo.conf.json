{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Umikaze Demo",
  "version": "3.2.0",
  "identifier": "jp.example.umikaze.demo",
  "mainBinaryName": "umikaze-demo",
  "build": {
    "beforeDevCommand": "npm run prepare:demo",
    "beforeBuildCommand": "npm run prepare:demo",
    "frontendDist": "../../dist/web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "海風 — 体験版",
        "width": 1280,
        "height": 720,
        "minWidth": 390,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Game",
    "icon": ["icons/128x128.png"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
