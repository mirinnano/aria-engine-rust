{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Umikaze",
  "version": "3.2.0",
  "identifier": "jp.example.umikaze",
  "build": {
    "beforeDevCommand": "npm run prepare:desktop",
    "beforeBuildCommand": "npm run prepare:desktop",
    "frontendDist": "../../dist/web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "海風 — The Records of Autumn",
        "width": 1280,
        "height": 720,
        "minWidth": 390,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Game",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../licenses": "licenses"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
