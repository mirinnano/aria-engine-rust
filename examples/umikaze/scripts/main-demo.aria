aria;
module umikaze.demo_main;
entry start;

// A demo is a separate import closure, not a runtime flag hidden inside the
// full game. Later manuscript modules are therefore absent from its ARIAC.
use "scenario/demo.aria";

scene start {
  locale "ja-JP";
  text_speed 48;
  persistent flag "umikaze_demo_setup_complete" = true;
  jump title_screen;
}

scene title_screen {
  background asset("#264450") with fade(240ms);
  stage tide;
  screen title;
  choice { "体験版をはじめる" => demo_chapter_select; }
}
