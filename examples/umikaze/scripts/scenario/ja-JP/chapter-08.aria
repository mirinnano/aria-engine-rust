  label "DAY 8";
  numeral "VIII";
  title "霧の海";
  date "9月28日・直島";
  synopsis "民宿で朝を迎え、霧の濃くなる海を本州行きの船で戻る。";
  image asset("assets/bg/scenes/understructure-evening-v1.webp");
  start novel_chapter_08;
}

// Source: 08_day8.md — 175 player-visible beats
scene novel_chapter_08 {
  locale "ja-JP";
  persistent flag "canonical_chapter_08_seen" = true;
  unlock chapter "canonical_chapter_08" progress 1;
  background asset("assets/bg/scenes/mountain-room-dawn-v1.webp") with fade_through_black(640ms);
