  clear dialogue;
  wait 170ms;
  say ミオ: "「...はぁ」";
  await advance;
  clear dialogue;
  wait 170ms;
  narrate "...窓から見える空がすっかりと黒くなった頃。";
  await advance;
  narrate "俺たちは、どこへ向かうかもわからない、古びた二両編成の鈍行列車に乗り込んでいた。";
  await advance;
  clear dialogue;
  wait 170ms;
  narrate "ガラガラに空いた車内。";
  await advance;
  narrate "暖房の効いたボックス席に沈み込むと、ミオはすぐに目を閉じた。";
  await advance;
  clear dialogue;
  wait 170ms;
  narrate "カタン、コトンと、規則正しい揺れだけが響く。";
  await advance;
  clear dialogue;
  wait 170ms;
  narrate "窓ガラスには、真っ黒な外の景色と、";
  await advance;
  narrate "ひどく疲れた顔をした俺自身の顔が映っていた。";
  await advance;
  clear dialogue;
  wait 170ms;
  narrate "行き先はわからない。";
  await advance;
  narrate "けれど、もう後戻りできないことだけは、確かにわかっていた。";
  await advance;
  chapter "canonical_chapter_08" progress 100;
  clear dialogue;
  background asset("#05070b") with fade(480ms);
  wait 480ms;
  jump chapter_select_ja;
}
