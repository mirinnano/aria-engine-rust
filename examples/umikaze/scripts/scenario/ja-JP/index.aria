aria;
module umikaze.scenario.ja;

// Generated from the canonical Day 0–11 Markdown source.
// Each chapter remains its own reviewable Aria module.
use "chapter-00.aria";
use "chapter-01.aria";
use "chapter-02.aria";
use "chapter-03.aria";
use "chapter-04.aria";
use "chapter-05.aria";
use "chapter-06.aria";
use "chapter-07.aria";
use "chapter-08.aria";
use "chapter-09.aria";
use "chapter-10.aria";
use "chapter-11.aria";

scene chapter_select_ja {
  screen chapter_select;
  background asset("#102b38") with wipe(260ms);
  stage tide;
  choice {
    chapter canonical_chapter_00;
    chapter canonical_chapter_01;
    chapter canonical_chapter_02;
    chapter canonical_chapter_03;
    chapter canonical_chapter_04;
    chapter canonical_chapter_05;
    chapter canonical_chapter_06;
    chapter canonical_chapter_07;
    chapter canonical_chapter_08;
    chapter canonical_chapter_09;
    chapter canonical_chapter_10;
    chapter canonical_chapter_11;
    cancel => title_screen;
  }
}
