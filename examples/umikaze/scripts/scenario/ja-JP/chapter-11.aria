aria;
module umikaze.scenario.ja.chapter_11;

// Catalogue metadata for the chapter select and the day card.
chapter canonical_chapter_11 {
  label "DAY 11";
  numeral "XI";
  title "小さな駅";
  date "10月1日・山陰本線";
  synopsis "山陰本線の小さな駅で降り、夜の商店で水を買う。";
  image asset("assets/bg/scenes/blue-twilight-v1.webp");
  start novel_chapter_11;
}

// Source: 11_day11.md — 82 player-visible beats
scene novel_chapter_11 {
  locale "ja-JP";
  persistent flag "canonical_chapter_11_seen" = true;
  unlock chapter "canonical_chapter_11" progress 1;
  background asset("assets/bg/scenes/blue-twilight-v1.webp") with fade_through_black(640ms);
  stage north;
  screen day_card;
  choice {
    chapter canonical_chapter_11 => novel_chapter_11_story;
  }
}

scene novel_chapter_11_story {
  prose breath 300ms {
    screen dialogue;
    background asset("assets/bg/scenes/blue-twilight-v1.webp") with fade(360ms);
    wait 180ms;
    "10月1日。";
    pause 220ms;
    "山陰本線での下車。";
    "次の駅で、俺たちは列車を降りた。";
    "ホームには、頼りない屋根と古びたベンチしかなかった。";
    "列車が、遠ざかる。";
    pause 220ms;
    "かすかな煙を残して。";
    "俺はポケットからおもむろに煙草を取り出す。";
    pause 220ms;
    "火をつける。";
    "「君って、案外吸わないんだね」";
    "「別に、俺は自制できるからな」";
    "「ふ〜ん、そっか」";
    "「...喉が渇いたな」";
    "「そんなもの吸うからだよ」";
    "「駅、出るぞ」";
    "駅舎の外を覗く。";
    pause 220ms;
    "街灯の先に、低い建物がいくつか並んでいた。";
    pause 220ms;
    "とくに、店らしい明かりは見えない。";
    "「なにもない」";
    "空を見上げる。";
    pause 220ms;
    "都会と違って、街の明かりが少ないせいなのか。";
    pause 220ms;
    "星がよく見えた。";
    pause 220ms;
    "...あれはなんの星座なんだろう？";
    "「なあ、あれってなんの星座？」";
    "「うーんとね...多分」";
    "ミオはしばらく空を見ていた。";
    "「分かんない」";
    "「なんだよ」";
    "「月、明るすぎるから」";
    "「わかんないなら、最初からそう言えよ」";
    "「期待して損した」";
    "「私が博識に見える？」";
    "ミオの視線が、空から俺に移る。";
    "「まあ、少しは...」";
    "「ふーん...」";
    "煙草の火を消す。";
    "「ほら、早く商店でもなんでもいいから探すぞ」";
    "「はぁい...」";
    "ミオは、すぐには動かなかった。";
    "駅舎を出る。";
    "ミオの足音は、少し遅れてついてきた。";
    pause 220ms;
    "俺は歩幅を落とした。";
    "しばらく歩くと、道の先に白い明かりが見えた。";
    pause 220ms;
    "近づくと、小さな商店の蛍光灯だった。";
    "「ねえっ、ほらっ、店あったよ」";
    "「知ってるよ...」";
    "ガラガラと戸を開け、所狭しと商品が積まれた商店に入る。";
    "アサヒビールのロゴが入った冷蔵庫。";
    pause 220ms;
    "そこから、水を二本取り出す。";
    "それと、柿ピーでも。";
    pause 220ms;
    "レジに向かう。";
    "おじいさんが、ゆっくりとレジを打つ。";
    pause 220ms;
    "財布には480円しかなかった。";
    "レジに映し出された数字は、430。";
    pause 220ms;
    "なんとか足りた、けれど...";
    pause 480ms;
    "残った金でうまい棒でも食えってか。";
    "財布に残った小銭を、すべて出す。";
    pause 220ms;
    "五十円玉が一枚、返ってきた。";
    "商店を出て、柿ピーの袋を開ける。";
    "「久々に食うな...」";
    "「そりゃ、こんなの酒のおつまみだしね」";
    "「そのまま食っても美味いだろ」";
    "「そうだけどさ」";
    "「お酒に合いそうな味じゃんか」";
    "「飲んだことあるの？」";
    "「さあ」";
    pause 220ms;
    "俺は、そっと目線をそらした。";
    "「...」";
    "「別にいいけどよ」";
    "「じゃあ、そのうち二人で飲むか？」";
    "「やめとく」";
    "「...身体に悪いから」";
    "「今更、だろ」";
    "「...まあね」";
    "俺は、歩き出す。";
    "「ほら、駅戻るぞ」";
    "「そこで寝よう」";
    "「あそこかぁ...」";
    "ミオはうつむいた。";
    "「もっといい場所、ないの？」";
    "「もう探すのは疲れた、我慢しろ」";
    "「...」";
    pause 220ms;
    "ミオも、俺の背中を追うように歩き出した。" +;
    chapter "canonical_chapter_11" progress 100;
    clear dialogue;
    background asset("#05070b") with fade(480ms);
    stage blackout;
    wait 480ms;
    jump chapter_select_ja;
  }
}
