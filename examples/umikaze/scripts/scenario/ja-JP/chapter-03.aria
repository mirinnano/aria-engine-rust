  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "駅の構内へと歩みを進め、路線図を見上げた。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "「次は、どこへ行こうか」";
