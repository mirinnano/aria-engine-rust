  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "男はテレビから目を上げ、鍵を受け取った。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "「……どうも」";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "自動ドアを抜ける。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "外は、淡いみずいろに包まれていた。";
  await advance;
  clear dialogue;
  wait breath 220ms;
