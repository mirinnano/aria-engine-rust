aria;
module umikaze.scenario.ja.chapter_05;

// Catalogue metadata for the chapter select and the day card.
chapter canonical_chapter_05 {
  label "DAY 5";
  numeral "V";
  title "雨の日";
  date "9月25日・益田";
  synopsis "朝から降る雨が、昼になっても弱まらない。";
  image asset("assets/bg/scenes/rain-street-evening-v1.webp");
  start novel_chapter_05;
}

// Source: 05_day5.md — 243 player-visible beats
scene novel_chapter_05 {
  locale "ja-JP";
  persistent flag "canonical_chapter_05_seen" = true;
  unlock chapter "canonical_chapter_05" progress 1;
  background asset("assets/bg/scenes/rain-street-evening-v1.webp") with fade_through_black(640ms);
  stage rain;
  screen day_card;
  choice {
    chapter canonical_chapter_05 => novel_chapter_05_story;
  }
}

scene novel_chapter_05_story {
  prose breath 220ms {
    screen dialogue;
    background asset("assets/bg/scenes/rain-street-evening-v1.webp") with fade(360ms);
    wait 180ms;
    clear dialogue;
    screen interlude;
    narrate "9月25日 益田のビジネスホテル";
    wait 1000ms;
    screen dialogue;
    clear dialogue;
    wait 220ms;
    clear dialogue;
    background asset("assets/bg/scenes/hotel-corridor-blue-v1.webp") with fade_through_black(640ms);
    wait 640ms;
    "雨の音で目が覚めた。";
    "昨日より近い。窓を叩く音というより、壁の向こうで何かが崩れているみたいだった。";
    "部屋は薄暗い。";
    "テーブルの端には、昨夜のままのおにぎりが置かれていた。袋は開いていない。";
    "時計の針は七時を過ぎていた。";
    "それでも外は明るくならない。";
    "エアコンの表示が、緑色に光っている。";
    "風は出ない。じめじめする。";
    "隣のベッドを見る。";
    "ミオは布団にくるまったまま、こちらを向かなかった。";
    "「ミオ。朝だぞ」";
    "返事はない。";
    "もう一度呼ぶと、布団の中で小さく動いた。";
    "「……起きてる」";
    "顔を出した頬が、少し赤かった。";
    "「顔、赤いぞ」";
    "「部屋が暑いだけ」";
    "窓の外は、朝なのに夕方みたいな色をしている。";
    "俺はカーテンを戻した。";
    "「今日は動かない。一泊、延ばす」";
    "「うん」";
    "「薬、まだあるのか」";
    "「……あるよ」";
    "ミオはそれだけ言って、また目を閉じた。";
    "俺はテーブルのおにぎりを手に取った。";
    "中身が冷えて固くなっているのが、袋の上からでもわかった。";
    "しばらく持ったまま、結局ゴミ箱へ入れた。";
    pause 0ms;
    wait 620ms;
    "フロントには、昨日と同じ管理人がいた。";
    "パイプ椅子に座ったまま、音量を絞ったテレビを見ている。";
    "「もう一泊、頼む」";
    "管理人は鍵を見て、帳面に何かを書いた。";
    "俺は言われた額を払う。";
    "テレビの中では、天気図の上を太い雲の帯が通っていた。";
    "管理人は一度だけ窓の外を見て、何も言わなかった。";
    "ロビーの自販機で、水とおしるこ、それからブラックコーヒーを買った。";
    "エレベーターの鏡には、寝癖のままの俺が映っていた。";
    "部屋へ戻ると、ミオはベッドから起きていた。";
    "椅子に座り、窓のほうを見ている。";
    "「水。あと、これ」";
    "テーブルに缶を置く。";
    "「ありがと」";
    "ミオは巾着から薬を一錠出した。";
    "水で流し込み、しばらく口を閉じていた。";
    "「苦いか」";
    "「いつもの」";
    "おしるこの缶を両手で包む。";
    "それでも、すぐには開けなかった。";
    "俺はブラックコーヒーを開けた。";
    "冷えた缶を口に当てると、雨の音が少し遠くなった。";
    pause 0ms;
    play bgm asset("assets/audio/bgm/umk.rain.room.ogg") loop fade 800ms;
    wait breath 220ms;
    "「なあ」";
    "「なに」";
    "「ほかに、なんか本ないか」";
    "ミオは鞄の中を探り、端の擦れた文庫本を出した。";
    "差し出されたのは、『銀河鉄道の夜』だった。";
    "「何回くらい読んだんだ、それ」";
    "「わかんない。病室にいたとき、よく読んでた」";
    "表紙には、星の中を走る列車が描かれていた。";
    "ページの端は湿気を吸って、少しだけ波打っている。";
    "背を開くたび、古い糊がかすかに鳴った。";
    "俺は窓際の椅子に座り、開いた頁を読んだ。";
    "外では、雨がずっと同じ場所を打っている。";
    "窓の内側には、細い水滴がいくつも残っていた。";
    "大きくなったものから、下へ落ちていく。";
    "何頁か進んだところで、ミオが缶の蓋を開けた。";
    "甘い匂いが、湿った部屋に少しだけ広がる。";
    "「眠くならない？」";
    "「読める」";
    "「そっか」";
    "俺は、また頁をめくった。";
    "『けれどもほんとうのさいわいは一体何だろう。』";
    pause 0ms;
    wait 900ms;
    "その一行で、指が止まった。";
    "続きを読んでも、答えはすぐには出てこない。";
    "缶の底には、コーヒーが少しだけ残っていた。";
    "本を閉じると、紙の上に自分の指の跡が薄く残っていた。";
    "「どうだった？」";
    "いつの間にか、ミオがこちらを見ていた。";
    "「よくわからん」";
    "「私も」";
    "ミオは空いた缶を、静かにテーブルへ置いた。";
    pause 0ms;
    background asset("#05070b") with fade(260ms);
    stage blackout;
    wait 800ms;
    background asset("assets/bg/scenes/hotel-corridor-blue-v1.webp") with fade(360ms);
    wait 180ms;
    "昼になっても、雨は弱くならなかった。";
    "「腹、減ってないか」";
    "「少し」";
    "テーブルの端の、空いた場所を見る。";
    "ミオは見なかった。";
    "俺はさっき捨てたことを言わず、椅子を引いた。";
    "俺はフロントへ降り、油染みのついた出前のメニューを借りた。";
    "黒電話で、中華屋へ部屋番号を伝える。";
    "三十分ほどして、ドアが鳴った。";
    "雨の匂いに混じって、油とにんにくの匂いが部屋へ入ってくる。";
    "丸い皿のチャーハンと、餃子の皿。";
    "俺の前には、湯気の立つラーメンが置かれた。";
    "ミオは割り箸を割った。";
    "チャーハンを二口だけ食べる。";
    "三口目で、箸が止まった。";
    "餃子には手をつけない。";
    "「それ、もらうぞ」";
    "「……うん」";
    "チャーハンと餃子を自分のほうへ寄せる。";
    "ミオは窓に流れる雨を見ていた。";
    "俺は残りを食べ、空いた皿を重ねた。";
    "「食べてくれて、ありがと」";
    pause 0ms;
    wait 520ms;
    "「別に」";
    "ミオは、テーブルの端に残っていた空のおしるこ缶へ手を伸ばした。";
    "「なあ」";
    "「なに」";
    "「保健室に置いてったノート。あれ、忘れたんじゃねえだろ」";
    "缶の継ぎ目をなぞっていた指が止まった。";
    "「……どうして、そう思うの」";
    "「置く前に見ただろ。俺が寝てたベッドに」";
    "雨が窓を打った。";
    "ミオは缶を持ったまま、しばらく答えなかった。";
    pause 0ms;
    wait 900ms;
    "「俺が来なかったら、どうしてた」";
    "「一人で行ったよ」";
    "「桜木町までで倒れてただろ」";
    "「そうかもね」";
    "ミオは缶をテーブルへ戻した。";
    "「……じゃあ、来てくれてよかった」";
    "「人を勝手に当てにすんな」";
    pause 0ms;
    screen statement;
    background asset("#6d706f") with fade(260ms);
    stage stillness;
    narrate "「じゃあ、どうして来たの」";
    wait 1600ms;
    background asset("assets/bg/scenes/hotel-corridor-blue-v1.webp") with fade(360ms);
    screen dialogue;
    clear dialogue;
    wait 180ms;
    "俺は答えなかった。";
    "ミオも、それ以上は聞かなかった。";
    pause 0ms;
    wait 1100ms;
    "「寝るか」";
    "「うん」";
    pause 0ms;
    background asset("#05070b") with fade(260ms);
    stage blackout;
    wait 1000ms;
    background asset("assets/bg/scenes/hotel-corridor-blue-v1.webp") with fade(360ms);
    wait 180ms;
    "ミオが眠ってからも、俺は眠れなかった。";
    "雨は窓の外で、同じ音を繰り返している。";
    "エアコンは弱い風しか出さない。";
    "濡れたまま掛けた服は、まだ壁際で重そうに垂れていた。";
    "鞄の中を探ると、折れたレシートが一枚出てきた。";
    "家を出た朝、コンビニで水だけを買った時のものだった。";
    "印字された日付をしばらく見て、丸めてゴミ箱へ投げた。";
    "レシートは縁に当たって、床へ落ちた。";
    "拾い直すのも面倒で、そのままにした。";
    "鞄の底から、家を出る朝に放り込んだゲームボーイカラーが出てきた。";
    "音を消して、電源を入れる。";
    "薄い液晶の中で、形の違うブロックが落ちてきた。";
    "暗くて、画面がよく見えない。窓のほうへ傾けた。";
    "形の違うブロックを、何度か消した。";
    "ひとつ置き場所を間違えると、その上へまた次が落ちてくる。";
    "画面が埋まる前に、電源を切った。";
    "灰色に戻った画面に、窓が映っていた。";
    pause 0ms;
    wait 620ms;
    "「……ねえ」";
    "呼ばれて振り返る。";
    "ミオが薄く目を開けていた。";
    "「何時だ」";
    "「六時」";
    "「そっか」";
    "少し間を置いて、ミオは言った。";
    "「おでん、食べたい」";
    pause 0ms;
    wait 520ms;
    "窓の外を見る。";
    "雨はまだ、横から降っている。";
    "「この雨で？」";
    "「君が行ってきて」";
    "「俺はお前のパシリじゃねえぞ」";
    "「知ってる」";
    "ミオは布団の中で、少しだけ笑った。";
    pause 0ms;
    stop bgm fade 700ms;
    wait breath 220ms;
    "俺は財布を取り、濡れた靴を履いた。";
    pause 0ms;
    background asset("assets/bg/scenes/rain-street-evening-v1.webp") with fade_through_black(640ms);
    wait 640ms;
    "ホテルの扉を開けると、風に押し返された。";
    "数歩で髪が濡れ、袖が重くなる。";
    "傘はなかった。";
    "俺は片腕で頭をかばい、もう片方の手で財布を押さえた。";
    "靴の中まで水が入る。";
    "歩くたびに、かかとの下で小さく音がした。";
    "国道沿いには車がほとんどいない。";
    "たまに通る車が、水をはね上げていく。";
    "コンビニの看板を見つける。";
    "白い灯りの下へ入ると、目が痛くなった。";
    "自動ドアの音が鳴る。";
    "店内には、雑誌を読んでいる店員しかいなかった。";
    "濡れた靴底が、床に小さな跡を残す。";
    "冷蔵庫の明かりの前で、しばらく立ち止まる。";
    "プリンの棚には、同じものが何個も並んでいた。";
    "おでんの前で、少し考える。";
    "たまごと大根、しらたき。";
    "自分の分に、牛すじを足した。";
    "棚からプリンを一つ取る。";
    "カップの蓋を閉めてもらう間、湯気がレジのガラスを曇らせた。";
    "店員は俺の濡れた袖を見て、それから商品を袋に入れた。";
    "何も言わない。";
    "入口のビニール傘へ目をやった。";
    "値札を見て、手を伸ばさなかった。";
    "レジ袋を持って店を出る。";
    "袋越しに、カップが温かい。";
    "帰り道では、行きより風が強かった。";
    "袋が膝に当たるたび、中の汁が少し揺れた。";
    pause 0ms;
    background asset("assets/bg/scenes/hotel-corridor-blue-v1.webp") with fade_through_black(640ms);
    wait 640ms;
    "部屋へ戻ると、ミオはテーブルの前に座っていた。";
    "俺の髪から落ちる雫を見て、眉を寄せる。";
    "「そんなに降ってた？」";
    "「見りゃわかるだろ」";
    "「先に風呂入って」";
    "「お前、腹減ってたんじゃないのか」";
    "「一人で食べても、つまんない」";
    "俺は何も言わず、浴室へ入った。";
    "熱い湯を浴びる。";
    "雨の冷たさが、皮膚の上から少しずつ離れていく。";
    "鏡はすぐに曇った。";
    "向こう側の自分の顔は、最後までよく見えなかった。";
    "戻ると、おでんの蓋はまだ閉じたままだった。";
    "テーブルの上には、ミオの手で二つの紙コップが並べられている。";
    "片方には割り箸が刺さっていた。";
    "「食うか」";
    "「うん」";
    "ミオは大根を一口だけかじった。";
    "少し噛んで、箸を止める。";
    "「もういいのか」";
    "「あとで食べる」";
    "俺は何も言わず、残りを自分のカップへ移した。";
    "テーブルの真ん中に置いたプリンは、蓋も開かないままだった。";
    "ミオはそれを一度見て、また窓へ目を戻した。";
    "俺は空いたカップを重ね、レジ袋の口を縛った。";
    "結び目がうまく作れず、一度ほどいてやり直した。";
    pause 0ms;
    wait 620ms;
    "部屋の明かりを落とす前に、ミオがMDウォーカーを取り出した。";
    "窓際へ置き、マイクをガラスの近くへ向ける。";
    "赤いランプが灯る。";
    "ミオは一度だけ、ガラスに近づく雨の音を確かめるように耳を傾けた。";
    "「九月二十五日。益田。雨」";
    "それだけ言って、ミオは録音を続けた。";
    "ベッドに入ってから、しばらく誰も話さなかった。";
    "MDには、雨とエアコンの低い音が残っているはずだった。";
    "録音中の赤いランプは、暗い部屋の隅で消えずにいた。";
    "「……私、雨の日って嫌いじゃないんだよね」";
    "「物好きだな。こんな嵐なのに」";
    "「病室って、晴れてるとうるさいの。隣のベッドに、お見舞いの人が来るし、看護師さんも元気で」";
    "俺は暗い天井を見ていた。";
    "「みんな、私のために笑ってくれる。でも、あれは少し疲れる」";
    "「雨の日は？」";
    "「静か。誰も来ない。雨の音だけ聞いてればいいから」";
    "「……そうか」";
    "「ねえ、君ってさ」";
    "「なんだよ」";
    "「卒業したら、何するの」";
    pause 0ms;
    wait 700ms;
    "「……さあな。考えたことねえよ」";
    "「ふうん」";
    "しばらくして、ミオが小さく息を吐いた。";
    "「……いいな。考えなくていいの」";
    "「もし、私が明日帰るって言ったら」";
    "「帰りたきゃ帰れよ」";
    "「君は？」";
    "俺は返せなかった。";
    pause 0ms;
    wait 1400ms;
    "暗闇の向こうで、ミオが小さく息を吐いた。";
    "「……おやすみ」";
    "「ああ」";
    "しばらくして、ミオの寝息が整っていった。" +;
    chapter "canonical_chapter_05" progress 100;
    clear dialogue;
    background asset("#05070b") with fade(480ms);
    stage blackout;
    wait 480ms;
    jump chapter_select_ja;
  }
}
