aria;
module umikaze.scenario.ja.chapter_04;

// Catalogue metadata for the chapter select and the day card.
chapter canonical_chapter_04 {
  label "DAY 4";
  numeral "IV";
  title "波の音";
  date "9月24日・松江";
  synopsis "ミオがMDを持って、日本海の波の音を録りに行く。";
  image asset("assets/bg/scenes/shore-storm-sunset-v1.webp");
  start novel_chapter_04;
}

// Source: 04_day4.md — 125 player-visible beats
scene novel_chapter_04 {
  locale "ja-JP";
  persistent flag "canonical_chapter_04_seen" = true;
  unlock chapter "canonical_chapter_04" progress 1;
  background asset("assets/bg/scenes/shore-storm-sunset-v1.webp") with fade_through_black(640ms);
  stage shore;
  screen day_card;
  choice {
    chapter canonical_chapter_04 => novel_chapter_04_story;
  }
}

scene novel_chapter_04_story {
  prose breath 220ms {
    screen dialogue;
    background asset("assets/bg/scenes/shore-storm-sunset-v1.webp") with fade(360ms);
    wait 180ms;
    clear dialogue;
    screen interlude;
    narrate "9月24日 松江 7:00";
    wait 1000ms;
    screen dialogue;
    clear dialogue;
    wait 220ms;
    clear dialogue;
    background asset("assets/bg/scenes/hotel-corridor-blue-v1.webp") with fade_through_black(640ms);
    wait 640ms;
    "肩を揺すられて、目を開けた。";
    "黄ばんだ天井の下に、ミオの顔があった。";
    "「……何時だ」";
    "「七時。散歩、行こ」";
    "ミオはもう靴を履いていた。";
    "俺は枕元の時計を見て、もう一度目を閉じかける。";
    "「服、洗わないか」";
    "「……確かに。探そっか」";
    "ユニットバスで交代に着替え、脱いだ服を紙袋へ詰めた。";
    "外に出ると、冷たい空気が顔に当たった。";
    "金木犀の匂いが、通りの向こうから流れてくる。";
    "駅前のコインランドリーに入った。";
    pause 0ms;
    background asset("#6d706f") with fade_through_black(640ms);
    stage stillness;
    wait 640ms;
    "客はいない。紙袋の服を一つの洗濯機へ押し込んだ。";
    "蓋の向こうで、色の違う布が沈んでは浮いた。";
    "ミオはプラスチックの椅子に座り、膝の上の鞄を両手で押さえていた。";
    "「……別々に洗えばよかった」";
    "「いまさら言っても、遅いよ」";
    "洗濯槽が回り始めると、ミオは鞄からMDウォーカーを出した。";
    "小さなマイクをつなぎ、回る洗濯機へ向ける。";
    "「九月二十四日。松江のコインランドリー。私と君の服が回ってる」";
    pause 0ms;
    wait 620ms;
    "「残しておけば、あとで聞けるでしょ」";
    "「……まあな」";
    "ベンチの横には、半透明のケースが何枚か置かれていた。";
    "どのラベルも、まだ白いままだった。";
    "ミオは録音を止め、ディスクを取り出して、半透明のケースへ戻した。";
    "洗濯槽が止まるまで、俺たちはほとんど話さなかった。";
    "最後に、蓋のロックがカチンと外れた。";
    "ポケットの中で、J-PHONEの角が指に当たった。";
    "三ノ宮で切ったままの電源を入れる。";
    "起動音のあと、着信を知らせる通知が続けて届いた。";
    "画面の隅に、十四件、と表示されている。";
    pause 0ms;
    background asset("#05070b") with fade(260ms);
    stage blackout;
    wait 1000ms;
    background asset("#6d706f") with fade(360ms);
    stage stillness;
    wait 180ms;
    "名前は開かなかった。";
    "保存した写真を一枚だけ表示する。";
    "小さな液晶の中に、あの日の青い海があった。";
    "折りたたみを閉じ、もう一度、電源を切った。";
    "洗濯を終え、ホテルへ戻って鍵を返した。";
    "そのまま駅へ向かう。";
    "自販機で温かいミルクティーを二つ買い、一つをミオに渡した。";
    "「君にしては珍しいね」";
    "「別に」";
    "缶のプルタブを開ける。";
    "冷えた指に、スチール缶の熱が移った。";
    "ミオは両手で缶を持ち、しばらく口をつけなかった。";
    "「今日は、適当に駅を選んでみようぜ」";
    "路線図の前で、ミオは目を閉じた。";
    "指先が止まったのは、田儀だった。";
    "聞いたこともない駅だった。";
    "切符を買い、二両編成の気動車に乗り込む。";
    pause 0ms;
    background asset("assets/bg/scenes/rail-window-sunset-v1.webp") with fade_through_black(640ms);
    wait 640ms;
    "宍道湖が車窓の後ろへ流れ、しばらくすると、日本海が見えた。";
    "車内の座席は空いていた。";
    "ミオは窓際に座り、曇ったガラスを袖で一度だけ拭いた。";
    "「おい、着いたぞ」";
    pause 0ms;
    background asset("assets/bg/scenes/shore-storm-sunset-v1.webp") with fade_through_black(640ms);
    wait 640ms;
    "田儀駅のホームに降りる。";
    "ホームの先には砂浜があり、その向こうで海が鈍く光っていた。";
    "潮を含んだ風が、車内の暖房で温まった体を冷やした。";
    "ミオはMDウォーカーを取り出し、古びた階段を小走りで降りていった。";
    "「おい、走んな」";
    "返事はない。";
    "ミオは波打ち際まで行き、マイクを海へ向けて録音を始めた。";
    "波が一度、二度、砕けても、ミオは動かなかった。";
    "靴底の下で、湿った砂が少しずつ崩れた。";
    "録音を止めると、ミオは防波堤に座った。";
    "俺も砂に足を取られながら、その隣に腰を下ろす。";
    "砂が靴の中に入った。";
    "俺は脱がずに、足先だけを動かした。";
    "波が崩れる音を聞いていると、しばらくしてミオが腹に手を当てた。";
    "「……腹減ったか」";
    "「……うん」";
    "俺は立ち上がった。";
    "「駅、戻るか」";
    "袖が軽く引かれた。";
    "振り返ると、ミオは波のほうを見たまま、何も言わない。";
    pause 0ms;
    wait 700ms;
    "俺は手を差し出した。";
    "ミオの指が触れた。海風より冷たかった。";
    "砂浜から階段へ上がっても、手はそのままだった。";
    pause 0ms;
    wait 620ms;
    clear dialogue;
    background asset("assets/bg/scenes/rail-window-sunset-v1.webp") with fade_through_black(640ms);
    wait 640ms;
    "やってきた気動車に乗り込み、西へ向かう。";
    "車内の暖房で、指の間に汗が溜まった。それでも、どちらからともなく手を外さなかった。";
    "窓に映る日本海は、時間と一緒に色を変えた。";
    "明るい青が、鈍い鉛色になる。";
    "気がつけば、ミオは俺の肩に寄りかかって眠っていた。";
    "右手が痺れ、少しだけ指を動かす。";
    "眠ったまま、ミオの指が強く絡んだ。";
    "俺は窓の外を見た。";
    pause 0ms;
    wait 480ms;
    "『次は、益田――』";
    "気動車がブレーキ音を立て、車掌の声が車内に流れた。";
    "「着いたぞ」";
    "「……んん」";
    "ミオは目をこすり、繋いだ手を見た。";
    "黙って手を離し、窓のほうを向く。";
    "俺は痺れた右手を一度握って、立ち上がった。";
    pause 0ms;
    background asset("assets/bg/scenes/neon-alley-v1.webp") with fade_through_black(640ms);
    wait 640ms;
    "改札を抜けると、人の姿が少ない街があった。";
    "雲は低く、空の端まで黒かった。";
    "駅からすぐの古びたビジネスホテルに入る。";
    "ロビーには、カビと古い煙草の匂いが染み付いていた。";
    "管理人に現金を渡し、鍵を受け取った。";
    pause 0ms;
    background asset("assets/bg/scenes/hotel-corridor-blue-v1.webp") with fade_through_black(640ms);
    wait 640ms;
    "部屋には、細いベッドが二つ、壁際に並んでいた。";
    "荷物を置き、買い出しに出る。";
    pause 0ms;
    background asset("assets/bg/scenes/neon-alley-v1.webp") with fade_through_black(640ms);
    wait 640ms;
    "暗い道を十分ほど歩き、国道沿いのコンビニに入った。";
    "ミオはカップ麺とおにぎりを取る。";
    "俺は弁当を一つ選んだ。";
    "店を出ると、頬に冷たいものが当たった。";
    "雨粒がアスファルトに黒い点を増やしていく。";
    "傘はない。";
    "俺は制服のカーディガンを脱ぎ、ミオの頭へかけた。";
    "「走るぞ」";
    "ミオの手を引き、国道沿いを走る。";
    "雨はすぐに、髪と袖を重くした。";
    pause 0ms;
    background asset("assets/bg/scenes/rain-street-evening-v1.webp") with fade_through_black(640ms);
    wait 640ms;
    "ホテルへ戻る頃には、二人とも濡れていた。";
    pause 0ms;
    background asset("assets/bg/scenes/hotel-corridor-blue-v1.webp") with fade_through_black(640ms);
    wait 640ms;
    "「先、風呂入れ」";
    "ミオは黙って浴室へ入った。";
    "俺は煙草の臭いが残る椅子に座る。";
    "シャワーの音と雨音が、狭い部屋の中で重なっていた。";
    "濡れた服は、ユニットバスの扉に掛けた。";
    "入れ替わりで熱い湯を浴び、部屋へ戻る。";
    "ミオは小さなテーブルで、カップ麺に湯を注いでいた。";
    "おにぎりは、袋に入ったまま端に置かれている。";
    "窓ガラスが、湯気で少し曇った。";
    "俺が弁当を温め終える頃、ミオは麺を少しすすって、箸を置いた。";
    "「もういいのか」";
    "「あとで食べる」";
    "俺は弁当を食べた。";
    "ミオは箸を置いたまま、窓の外を見ていた。";
    "ガラスを雨が流れ続けていた。";
    "テーブルの端のおにぎりは、最後まで袋のままだった。";
    pause 0ms;
    wait 720ms;
    chapter "canonical_chapter_04" progress 100;
    clear dialogue;
    background asset("#05070b") with fade(480ms);
    stage blackout;
    wait 480ms;
    jump chapter_select_ja;
  }
}
