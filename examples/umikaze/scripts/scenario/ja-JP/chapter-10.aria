  clear dialogue;
  background asset("assets/bg/scenes/rail-window-sunset-v1.webp") with fade_through_black(640ms);
  wait 640ms;
  narrate "ミオは鞄から薬のシートを出した。";
  await advance;
  clear dialogue;
