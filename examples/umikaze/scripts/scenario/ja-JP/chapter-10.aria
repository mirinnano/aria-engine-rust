// Generated by aria import-novel --presentation umikaze --layout chapters.
// Canonical prose is embedded from the selected Markdown source file.
aria;
module umikaze.scenario.ja.chapter_10;

// Catalogue metadata for the chapter select and the day card.
chapter canonical_chapter_10 {
  label "DAY 10";
  numeral "X";
  title "灰色の海";
  date "9月30日・駅の待合室";
  synopsis "灰色の海のそばを、降りる理由のないまま進む。";
  image asset("assets/bg/scenes/terminus-grey-sea-v1.webp");
  start novel_chapter_10;
}

// Source: 10_day10.md — 46 player-visible beats
scene novel_chapter_10 {
  locale "ja-JP";
  persistent flag "canonical_chapter_10_seen" = true;
  unlock chapter "canonical_chapter_10" progress 1;
  background asset("assets/bg/scenes/terminus-grey-sea-v1.webp") with fade_through_black(640ms);
  stage terminus;
  screen day_card;
  choice {
    chapter canonical_chapter_10 => novel_chapter_10_story;
  }
}

scene novel_chapter_10_story {
  prose breath 220ms {
    screen dialogue;
    background asset("assets/bg/scenes/terminus-grey-sea-v1.webp") with fade(360ms);
    wait 180ms;
    clear dialogue;
    screen interlude;
    narrate "9月30日　駅の待合室　朝";
    wait 1000ms;
    screen dialogue;
    clear dialogue;
    wait 220ms;
    clear dialogue;
    background asset("assets/bg/scenes/platform-sea-dawn-v1.webp") with fade_through_black(640ms);
    wait 640ms;
    "硬いベンチで目を覚ますと、待合室に朝の光が差し込んでいた。";
    "体中が痛い。隣のミオは、俺の上着を抱えたまま、まだ眠っている。";
    "いつの間にか、シャッターは開いていた。";
    "ホームには、数人の客がいるだけだった。";
    "まだ眠ってるミオを叩き起こして、始発列車に乗った。";
    "行き先は見なかった。";
    pause 0ms;
    wait 720ms;
    "乗り換えの途中、昼ごはんを食べる。";
    "ホームの端にある立ち食いの店に入って、" +;
    "湯気を上げるかけうどんを一つ頼み、割り箸を割る。";
    "先にミオへ食べさせて、残りを俺がもらうことにした。";
    "ミオは三口ほど啜って、箸を置いた。";
    say ミオ: "「......もういい。残り、食べていいよ」";
    await advance;
    clear dialogue;
    wait breath 220ms;
    "俺はミオの丼を引き寄せ、黙って食った。";
    "少しふやけた麺は、あまり味がしなかった。";
    "それでも、食えるからまだいいけどさ。";
    pause 0ms;
    wait 720ms;
    clear dialogue;
    background asset("assets/bg/scenes/rail-window-sunset-v1.webp") with fade_through_black(640ms);
    wait 640ms;
    "また列車に乗った。";
    "山を抜けるたび、低い町が見えた。";
    "夕方には、海沿いの小さな駅が続いた。";
    pause 0ms;
    background asset("assets/bg/scenes/shore-storm-sunset-v1.webp") with fade_through_black(640ms);
    wait 640ms;
    "どこも、降りる理由がなかった。";
    "窓の外は、ずっと同じ色をしていた。";
    "鉛色の空と、灰色の海。";
    pause 0ms;
    wait 520ms;
    clear dialogue;
    background asset("assets/bg/scenes/rail-window-sunset-v1.webp") with fade_through_black(640ms);
    wait 640ms;
    "ミオは鞄から薬のシートを出した。";
    "残りを数えるように指でなぞり、一錠だけ押し出す。";
    say 俺: "「水、あるか」";
    await advance;
    clear dialogue;
    wait breath 220ms;
    say ミオ: "「あるよ」";
    await advance;
    clear dialogue;
    wait breath 220ms;
    "ミオは、ペットボトルの底に残った水で薬を飲んだ。";
    pause 0ms;
    wait 900ms;
    "いつの間にか、ミオは眠っていた。";
    "気づけば、俺も眠っていた。";
    "目を覚ますと、喉がひどく渇いていた。";
    "列車はトンネルの中にいた。";
    "行き先を見ずに乗っているから、どこで停まり、どこが終点なのかも知らない。";
    "空になったペットボトルを振った。";
    "音はしなかった。";
    pause 0ms;
    wait 900ms;
    "一体、俺って何をしているんだろ。";
    "そんで、何したいんだろうか。";
    "家の机も、学校の机も、まだあの場所にある。";
    "戻れば、また同じ朝が来る。";
    "俺は、行きたい場所があったわけじゃない。";
    "ただ、同じ朝を終わらせたかった。";
    pause 0ms;
    screen statement;
    background asset("#6d706f") with fade(260ms);
    stage stillness;
    narrate "この無意味な生に、ピリオドを打ちたくて。";
    wait 1600ms;
    background asset("assets/bg/scenes/rail-window-sunset-v1.webp") with fade(360ms);
    screen dialogue;
    clear dialogue;
    wait 180ms;
    "そう思ったところで、停車を知らせるベルが鳴った。";
    "ミオは眠ったまま、俺の上着の袖を握っていた。";
    "俺は立ち上がらなかった。";
    pause 0ms;
    wait 1800ms;
    "俺は、空になったペットボトルを拾った。";
    "次の駅で、水を買うことにした。";
    pause 0ms;
    wait 1000ms;
    chapter "canonical_chapter_10" progress 100;
    clear dialogue;
    background asset("#05070b") with fade(480ms);
    stage blackout;
    wait 480ms;
    jump chapter_select_ja;
  }
}
