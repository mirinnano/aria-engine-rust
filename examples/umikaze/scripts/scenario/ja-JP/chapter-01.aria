  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "ふと、気になったことを聞いてみる。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "「お前って、医者に食事制限とかされてんの？」";
  await advance;
  clear dialogue;
  wait breath 220ms;
