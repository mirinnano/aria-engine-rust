  background asset("assets/bg/scenes/rail-window-sunset-v1.webp") with fade_through_black(640ms);
  wait 640ms;
  narrate "「ねえ。起きてよ」";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "肩を揺すられて、ハッと目を覚ます。";
