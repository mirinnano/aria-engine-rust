// Source: 00_init.md — 265 player-visible beats
scene novel_chapter_00 {
  locale "ja-JP";
  persistent flag "canonical_chapter_00_seen" = true;
  unlock chapter "canonical_chapter_00" progress 1;
  background asset("assets/bg/scenes/hospital-corridor-overcast-v1.webp") with fade_through_black(640ms);
  screen day_card;
  choice {
    "PROLOGUE\nP\n幸福は、世界のなかの事実ではない。\n春から九月\n季節だけが先に進む窓辺で、まだ名もない願いが揺れている。" => novel_chapter_00_story;
  }
}

scene novel_chapter_00_story {
  screen dialogue;
  background asset("assets/bg/scenes/hospital-corridor-overcast-v1.webp") with fade(360ms);
  wait 180ms;
  narrate "病室の窓から見える景色は、毎日少しずつ変わっていく。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "けれど、私の一日はほとんど変わらない。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "小学校の時に初めて倒れて入院して以来、";
  await advance;
  narrate "私の世界は、この一部屋に収まるほどのちんけなものになってしまった。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "毎日窓から景色を見て、それ以外は寝る生活。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "テレビなんてとっくに飽きちゃって。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "たまに部屋が静かすぎて、テレビをつけるぐらいのこと。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "お見舞いなんて誰も来ない。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "来たって、お母さんぐらいだし、友達ももう、他人みたいなものになってしまった。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "今更友達になんて会えなくて、みんながなにかしてるのに、私は寝てるだけ。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "病人って、これが普通なんだろうけど。";
  await advance;
  clear dialogue;
  screen statement;
  background asset("#6d706f") with fade(260ms);
  narrate "「だって、人が死ぬとこなんて...わざわざ見る人なんていないもんね」";
  wait 1600ms;
  background asset("assets/bg/scenes/hospital-corridor-overcast-v1.webp") with fade(360ms);
  screen dialogue;
  clear dialogue;
  wait 180ms;
  narrate "私はいつものように、窓のむこうを見る。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "「きれいな桜...」";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "桜は満開の季節。けれど、近くで見れるわけでもない。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "独りで見に行きたいのに、毎回看護師さんがついてくる。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "人に見られてたら、なんか落ち着かなくて。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "もう死ぬんだから、ほおっておいてくれてもいいのにね...";
  await advance;
  clear dialogue;
  wait breath 480ms;
  narrate "窓のむこうで、桜が舞い散る。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "そして数日、また数日と経ち、桜が枯れる頃。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "お母さんがお見舞いに来た。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "「...来てくれたんだ」";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "そこから、他愛ない話を30分ぐらいした。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "「なんか、看護師さんに言われたんだけれど...」";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "「お家、一旦帰っていいってよ」";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "お母さんが、私の目を見て話す。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "「そっか」";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "それが何を意味するかってのは、私でもわかる。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "「...お家、帰る？」";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "「さあ...ちょっと考えさせて」";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "結局のところ、家にいたって、ここにいたって、寝たきりなのは変わらない。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "帰る意味...まあ、世話してくれたし、最後ぐらいは家で過ごしてもいいのかもな。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "母親はまだ、私の目を見ている。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "笑顔で、けれど泣きそうな顔で。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "私はその目を見つめ返す。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "「...帰ろう」";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "母親は、ハンカチで涙を拭いた...";
  await advance;
  clear dialogue;
  wait breath 480ms;
  narrate "親の車で、家にたどり着いた。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "珍しく家全体が大掃除でもしたかのようにピカピカ。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "私の部屋を覗く。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "整理整頓された勉強机、ホテルみたいに整理されたベッド。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "クローゼットの中は、子供の頃と全く変わっていなかった。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "なんとなく、勉強机に向き合ったりしてみる。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "いまさら、教科書なんて開く気になれなくて。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "ベッドに横たわる。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "天井を見た。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "白い。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "いつの間にか、寝ていた。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "そして、いつの間にか、目を覚ましていた。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "横を見ると、ラップに包まれたお粥が置かれてる。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "まだほんのりと温かい。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "ラップを取り、お粥をスプーンですくう。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "味、うすいな...";
  await advance;
  clear dialogue;
  wait breath 480ms;
  narrate "昔食べさせてくれたお粥とは全く違って...";
  await advance;
  clear dialogue;
  wait breath 480ms;
  narrate "ちょっとずつ食べていると、お母さんがドアを開けて覗いていた。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "目線を合わす。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "お母さんはドアを閉め、去っていった。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "お粥を食べる。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "さっきより、塩気が強いって思うのは、なんでだろ...";
  await advance;
  clear dialogue;
  wait 620ms;
  narrate "桜は散り、幾度の雨が降る季節のこと。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "じめじめした部屋で、私は今日も寝ていた。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "私の部屋で、洗濯物が干されてる。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "だから、じめじめするのか。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "なんとなく立ち上がってみて、また勉強机に座ってみる。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "教科書の隣に挟まってるノートを読んでみる。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "英語のノートだった。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "三単現について勉強してたみたい。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "少し疲れて、布団に戻る。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "「暇だなぁ」";
  await advance;
  clear dialogue;
  wait 520ms;
  narrate "外ではうるさく蝉が鳴いている。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "クーラーから冷たい風が吹き、とても涼しい。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "部屋の中は暗かった。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "ずっと寝て、少し起きる生活。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "今が何時なのかすらわからない。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "カーテンがしまってる。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "少し立とうとして、めんどくさいからやめた。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "扉が開く。お母さんだ。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "「...麦茶、持ってきたよ」";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "「ありがと」";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "お母さんが、私の横にトレーを置く。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "そっか、昼なのか...";
  await advance;
  clear dialogue;
  wait breath 480ms;
  narrate "扉の向こうから、光が差し込む。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "また、寝よう...";
  await advance;
  clear dialogue;
  wait 620ms;
  narrate "あんなにうるさかった蝉が消え、少し涼しくなった頃。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "また、私は寝ていた。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "パジャマは半袖から長袖へと変わった。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "なんとなく、また勉強机へと向かう。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "前に開いた英語のノートの空きページを開いてみた。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "ノートはまだ半分も余っていた。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "一人で外を見たい。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "誰にも見張られずに歩きたい。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "部屋から出て、家の書斎を漁る。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "本棚には、古い時刻表があった。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "なんとなく、それを読んでみた。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "びっしりと並ぶ数字の羅列。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "駅名とか、細かい数字が並ぶ本を部屋に持ち帰る。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "ノートに書き写す。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "わたしの家の最寄り駅から、ひたすら、知っている駅へとつなげてく。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "数十分経って、お母さんが家に帰ってきた。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "焦ってノートを閉じ、布団に入る。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "「寝るかな...」";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "布団を被る。いつもより早く、寝れた気がした。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "また、ノートを開く。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "最初は知っている駅と知っている駅をつなぐ程度だったのが、";
  await advance;
  narrate "今は最適なルートを選べてる気がする。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "お母さんがいない時間に、いろいろな本を見たおかげかな。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "結局、桜木町まで歩いて、そっから横浜に行って、東海道線に乗ることにした。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "なんか、最寄り駅だと知ってる人いるから。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "嫌だなって。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "「蝉が死んでる...」";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "秋の朝のこと。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "私は、荷物を取りに学校に向かっていた。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "英語のノートだけは、手に抱えて。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "持っていくか迷ったけど、お母さんに見られるのが一番嫌だから。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "行く前にも、何回も「送っていこうか？」って言われたけど、何回も嫌だって言ったら、渋々許してくれた。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "帰りはお母さんが迎えに来るらしい。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "昔に使った、裏道を使って学校に行く。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "「疲れた...」";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "「こんなに坂、きつかったっけな」";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "まあ、それも病気のせいなんだろな。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "帰りは下るだけ、それなら許せる...";
  await advance;
  clear dialogue;
  wait breath 480ms;
  narrate "坂を登って、トンネルを通って、私は学校にたどり着いた。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "インターホンを押す。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "「...」";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "何も話していないのに、ドアのロックが開く音がした。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "また坂を登り、校舎につく。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "職員専用の入口から入って、職員室に行く。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "ノックをする。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "ガラガラ、と音がして、担任の先生？がたくさんの配布物と、大事な書類を渡す。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "「ロッカーに残ってる荷物も持っていって」";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "...これだけじゃないのか。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "重いなぁ...";
  await advance;
  clear dialogue;
  wait breath 480ms;
  narrate "職員室を出て、階段を登る。わたしの教室は最上階だ。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "手すりにつかまって息を整えながら、最上階へとたどり着く。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "でも、その先にも階段は続いてた。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "...最上階の先から、金属を何度も揺らす音がした。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "ちょっと迷ったけれど、階段を登る。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "そこには、人の影があった。";
  await advance;
  clear dialogue;
  background asset("#284b59") with fade(360ms);
  wait 360ms;
  clear dialogue;
  screen interlude;
  narrate "9月18日　学校の保健室　昼休み";
  wait 1000ms;
  screen dialogue;
  clear dialogue;
  wait 220ms;
  narrate "仮病を使って保健室のベッドに潜り込み、毛布を被った。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "昼休みのチャイムが鳴る。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "廊下が一気に騒がしくなる。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "教室へ戻る気にはなれなかった。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "いっそこのまま、目覚めなければいいのに。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "そう思いながら目を閉じていると、隣のベッドのカーテンがシャッ、と開いた。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "そこに立っていたのは、幽霊のように顔色の悪い少女だった。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "「……健康なくせに、そんなところでサボってるの？」";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "久しぶりに学校に来たという、難病を抱えたクラスメイト。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "ミオだった。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "「うるせえな。お前には関係ないだろ」";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "「……贅沢な悩み。いらないなら、その身体、私に頂戴」";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "「人の身体を勝手に欲しがるな」";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "「いらないんでしょ」";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "ミオは俺の返事も待たず、窓際の椅子に腰を下ろした。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "膝の上で、一冊のノートを開く。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "横から、びっしりと書き込まれた文字が見えた。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "駅の名前。時刻。金額。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "知らない地名ばかりだった。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "「何だ、それ」";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "「別に」";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "「駅名ばっかじゃねえか」";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "「見ないで」";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "ミオはノートを閉じ、俺から隠すように胸へ抱え込んだ。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "そのまま何度か咳き込む。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "廊下から、保健室の先生が顔を覗かせた。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "「迎え、来たみたいよ」";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "「……分かりました」";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "ミオはノートをベッドの上へ置き、ゆっくりと立ち上がる。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "「じゃあ」";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "「……ああ」";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "保健室のドアが閉まった。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "少しして、ベッドの上に残されたノートへ目をやる。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "「忘れてんじゃねえか」";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "追いかける気にはなれなかった。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "そのうち返せばいい。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "ノートを拾い上げる。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "表紙には、何も書かれていない。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "最初のページを開いた。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "九月二十一日、午前六時。横浜駅。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "その下には、列車の時刻と乗り換える駅が、細かく並んでいた。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "ページを捲っても、また駅名。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "西へ、西へ。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "最後の行には、海、とだけ書かれていた。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "俺はノートを閉じ、自分の鞄の底へ押し込んだ。";
  await advance;
  clear dialogue;
  screen interlude;
  narrate "9月20日　学校　朝";
  wait 1000ms;
  screen dialogue;
  clear dialogue;
  wait 220ms;
  narrate "珍しく、少し早く学校に来た。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "鞄の底には、あのノートが入っている。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "ちゃちゃっと返してしまいたかった。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "持っていても、邪魔だしな。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "教室を順に覗く。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "塾のワークとにらめっこをしているやつが、数人いるだけだった。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "ミオはいない。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "探すのをやめ、最上階まで階段を上る。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "その先にある屋上の扉へ手をかけた。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "開かない。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "取っ手を、何度か揺らす。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "金属音が階段に響いた。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "後ろで、足音が止まった。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "「誰だ」";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "振り向くと、手提げを持ったミオが立っていた。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "「...今って授業中だよね。ここで何してるの？」";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "「屋上、行こうとしてるんだ」";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "「開かないの？」";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "「鍵、かかってるみたい」";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "「...開けようと思わないの？」";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "「...思う」";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "ミオは手提げを足元に置いた。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "「じゃあ、手伝うよ」";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "「どうやってやるのさ」";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "「...どうしたらいいんだろうね」";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "「押してみる？　それとも引いてみる？」";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "「押してみよ」";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "二人で、扉に体当たりをした。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "重い金属音が、階段に反響する。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "「開かない...」";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "二度目。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "金属が裂けるような音がして、扉が急に外へ開いた。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "支えを失い、俺たちはそのまま屋上へ転がり込んだ。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "足元に、錆びたねじが跳ねた。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "南京錠は、掛け金に付いたままだった。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "「...開いた」";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "「壊れた、でしょ」";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "「まあ、そうとも言う...」";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "ミオは立ち上がり、そのまま屋上へ出た。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "俺も後を追う。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "屋上には、枯れ葉が舞い散っていた。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "校庭では、サッカーをやっている。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "そんな景色を、フェンス越しに見る。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "「風が...やばいね」";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "風が吹く。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "何度も、何度も。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "砂と落ち葉を巻き込み、俺の髪をなびかせる。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "鞄の底から、ノートを取り出した。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "「これ」";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "ミオは表紙を見て、それから俺を見た。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "「...見たの？」";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "「見えた」";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "ミオはノートを受け取り、手提げにしまった。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "「明日、六時」";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "「知ってる」";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "「そっか」";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "また、風が吹いた。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "「ねえ」";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "「本、好き？」";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "ミオは手提げから、一冊の文庫本を取り出した。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "「よだかの星。面白いよ...」";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "俺は文庫本を受け取った。";
  await advance;
  clear dialogue;
  wait 560ms;
  narrate "家に帰る。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "相変わらず、白い壁と、重たい勉強机が俺を待っている。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "鞄から『よだかの星』を取り出し、机の端に置いた。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "その横には、山のように積まれた課題と教材。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "俺には優秀な兄がいた。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "「お兄ちゃんはできたのに」";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "「どうして君にはできないんだ」";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "椅子に座る。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "少し、息が浅くなった。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "九月二十一日、午前六時。横浜駅。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "...明日の朝か。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "あんなやつが、本当に行くんだろうか。あの顔で、一人でさ。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "机の引き出しを開ける。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "親が置いていった、塾の夏季講習費が入った茶封筒。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "中身は見ていない。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "俺はそれを取り出し、財布にねじ込んだ。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "ノートを返しに行くわけではない。";
  await advance;
  clear dialogue;
  wait breath 220ms;
  narrate "ただ、この息の詰まる部屋から抜け出すための、言い訳が欲しかっただけ、なんだろう。";
  await advance;
  chapter "canonical_chapter_00" progress 100;
  clear dialogue;
  background asset("#05070b") with fade(480ms);
  wait 480ms;
  jump chapter_select_ja;
}
