// Generated by aria import-novel --presentation umikaze --layout chapters.
// Canonical prose is embedded from the selected Markdown source file.
aria;
module umikaze.scenario.ja.chapter_00;

// Catalogue metadata for the chapter select and the day card.
chapter canonical_chapter_00 {
  label "PROLOGUE";
  numeral "P";
  title "病室の窓";
  date "春から秋";
  synopsis "病室の窓から季節を見送る日々に、一時帰宅の話が出る。";
  image asset("assets/bg/scenes/hospital-corridor-overcast-v1.webp");
  start novel_chapter_00;
}

// Source: 00_init.md — 295 player-visible beats
scene novel_chapter_00 {
  locale "ja-JP";
  persistent flag "canonical_chapter_00_seen" = true;
  unlock chapter "canonical_chapter_00" progress 1;
  background asset("assets/bg/scenes/hospital-corridor-overcast-v1.webp") with fade_through_black(640ms);
  stage ward;
  screen day_card;
  choice {
    chapter canonical_chapter_00 => novel_chapter_00_story;
  }
}

scene novel_chapter_00_story {
  prose breath 220ms {
    screen dialogue;
    background asset("assets/bg/scenes/hospital-corridor-overcast-v1.webp") with fade(360ms);
    wait 180ms;
    clear dialogue;
    screen interlude;
    narrate "春から秋　ミオ";
    wait 1000ms;
    screen dialogue;
    clear dialogue;
    wait 220ms;
    "病室の窓から見える景色は、毎日少しずつ変わっていく。";
    "けれど、私の一日はほとんど変わらない。";
    "小学校の時に初めて倒れて入院して以来、" +;
    "私の世界は、この一部屋に収まるほどのちんけなものになってしまった。";
    "毎日、窓から景色を見て、それ以外は寝ている。";
    "テレビなんてとっくに飽きちゃって。";
    "たまに部屋が静かすぎて、テレビをつけるぐらいのこと。";
    "お見舞いなんて誰も来ない。";
    "来たって、お母さんぐらいだし、友達ももう、他人みたいなものになってしまった。";
    "今更友達になんて会えなくて、みんながなにかしてるのに、私は寝てるだけ。";
    "病人って、これが普通なんだろうけど。";
    pause 0ms;
    screen statement;
    background asset("#6d706f") with fade(260ms);
    stage stillness;
    narrate "「だって、人が死ぬところなんて……わざわざ見たい人なんて、いないもんね」";
    wait 1600ms;
    background asset("assets/bg/scenes/hospital-corridor-overcast-v1.webp") with fade(360ms);
    screen dialogue;
    clear dialogue;
    wait 180ms;
    "私はいつものように、窓のむこうを見る。";
    "桜の枝の先を、指でなぞった。";
    "「きれいな桜...」";
    "桜は満開の季節。けれど、近くで見れるわけでもない。";
    "独りで見に行きたいのに、毎回看護師さんがついてくる。";
    "人に見られてたら、なんか落ち着かなくて。";
    "ほおっておいてくれてもいいのにね……";
    pause 480ms;
    "窓のむこうで、桜が舞い散る。";
    "数日、また数日と過ぎ、桜が枯れる頃になった。";
    "病室のドアが開いた。";
    "ドアの先には、見慣れた顔。";
    "「お母さん...来てくれたんだ」";
    "お母さんがベッドの横に座った。";
    "話題が尽きかけ、少しの静寂が訪れたころ、母が口を開いた。";
    "「なんか、看護師さんに言われたんだけれど...」";
    "「お家、一旦帰っていいってよ」";
    "お母さんが、私の目を見て話す。";
    "「そっか」";
    "それが何を意味するかってのは、私でもわかる。";
    "「...お家、帰る？」";
    "「うん...ちょっと考えさせて」";
    "結局のところ、家にいたって、ここにいたって、寝たきりなのは変わらない。";
    "帰る意味……まあ、世話してくれたし、少しくらい家で過ごしてもいいのかもな。";
    "母親はまだ、私の目を見ている。";
    "笑顔で、けれど泣きそうな顔で。";
    "私はその目を見つめ返す。";
    "「...帰ろう」";
    "母親は、ハンカチで涙を拭いた...";
    pause 0ms;
    background asset("#6d706f") with fade_through_black(640ms);
    stage stillness;
    wait 640ms;
    "親の車で、家にたどり着いた。";
    "珍しく家全体が大掃除でもしたかのようにピカピカ。";
    "私の部屋を覗く。";
    "整理整頓された勉強机、ホテルみたいに整理されたベッド。";
    "クローゼットの中は、子供の頃と全く変わっていなかった。";
    "なんとなく、勉強机に向かってみる。";
    "いまさら、教科書なんて開く気になれなくて。";
    "ベッドに横たわる。";
    "天井を見た。";
    "白い。";
    "いつの間にか、寝ていた。";
    "そして、いつの間にか、目を覚ましていた。";
    "横を見ると、ラップに包まれたお粥が置かれていた。";
    "まだほんのりと温かい。";
    "ラップを取り、お粥をスプーンですくう。";
    "味、うすいな...";
    pause 480ms;
    "昔食べさせてくれたお粥とは全く違って...";
    pause 480ms;
    "ちょっとずつ食べていると、お母さんがドアを開けて覗いていた。";
    "目線を合わす。";
    "お母さんはドアを閉め、去っていった。";
    "お粥を食べる。";
    "さっきより、塩気が強いって思うのは、なんでだろ...";
    pause 0ms;
    background asset("#05070b") with fade(260ms);
    stage blackout;
    wait 900ms;
    background asset("#6d706f") with fade(360ms);
    stage stillness;
    wait 180ms;
    "桜は散り、幾度の雨が降る季節のこと。";
    "じめじめした部屋で、私は今日も寝ていた。";
    "私の部屋で、洗濯物が干されてる。";
    "だから、じめじめするのか。";
    "なんとなく立ち上がってみて、また勉強机に座ってみる。";
    "教科書の隣に挟まってるノートを読んでみる。";
    "英語のノートだった。";
    "三単現について勉強してたみたい。";
    "少し疲れて、布団に戻る。";
    "「暇だなぁ」";
    pause 0ms;
    background asset("#05070b") with fade(260ms);
    stage blackout;
    wait 760ms;
    background asset("#6d706f") with fade(360ms);
    stage stillness;
    wait 180ms;
    "外ではうるさく蝉が鳴いている。";
    "クーラーから冷たい風が吹き、とても涼しい。";
    "部屋の中は暗かった。";
    "ずっと寝て、少し起きる生活。";
    "今が何時なのかすらわからない。";
    "カーテンがしまってる。";
    "少し立とうとして、めんどくさいからやめた。";
    "扉が開く。お母さんだ。";
    "「...麦茶、持ってきたよ」";
    "「ありがと」";
    "お母さんが、私の横にトレーを置く。";
    "そっか、昼なのか...";
    pause 480ms;
    "扉の向こうから、光が差し込む。";
    "また、寝よう...";
    pause 0ms;
    background asset("#05070b") with fade(260ms);
    stage blackout;
    wait 900ms;
    background asset("#6d706f") with fade(360ms);
    stage stillness;
    wait 180ms;
    "あんなにうるさかった蝉が消え、少し涼しくなった頃。";
    "また、私は寝ていた。";
    "パジャマは半袖から長袖へと変わった。";
    "なんとなく、また勉強机へと向かう。";
    "前に開いた英語のノートの空きページを開いてみた。";
    "ノートはまだ半分も余っていた。";
    "一人で外を見たい。";
    "誰にも見張られずに歩きたい。";
    "部屋から出て、家の書斎を漁る。";
    "本棚には、古い時刻表があった。";
    "なんとなく、それを読んでみた。";
    "びっしりと並ぶ数字の羅列。";
    "駅名とか、細かい数字が並ぶ本を部屋に持ち帰る。";
    "ノートに書き写していく。";
    "私の家の最寄り駅から、知っている駅へ、ひたすら線をつないでいく。";
    "数十分経って、お母さんが家に帰ってきた。";
    "焦ってノートを閉じ、布団に入る。";
    "「寝るかな...」";
    "布団を被る。いつもより早く、寝れた気がした。";
    "また、ノートを開く。";
    "最初は知っている駅と知っている駅をつなぐ程度だったのが、" +;
    "今は最適なルートを選べてる気がする。";
    "お母さんがいない時間に、いろいろな本を見たおかげかな。";
    "結局、桜木町まで歩いて、そっから横浜に行って、東海道線に乗ることにした。";
    "なんか、最寄り駅だと知ってる人いるから。";
    "嫌だなって。";
    pause 0ms;
    screen interlude;
    narrate "9月18日　学校へ向かう道　ミオ";
    wait 1000ms;
    screen dialogue;
    clear dialogue;
    wait 220ms;
    "「蝉が死んでる...」";
    "秋の朝のこと。";
    "私は、荷物を取りに学校に向かっていた。";
    "英語のノートだけは、手に抱えて。";
    "持っていくか迷ったけど、お母さんに見られるのが一番嫌だから。";
    "行く前にも、何回も「送っていこうか？」って言われたけど、何回も嫌だって言ったら、渋々許してくれた。";
    "帰りはお母さんが迎えに来るらしい。";
    "昔に使った、裏道を使って学校に行く。";
    "「疲れた...」";
    "「こんなに坂、きつかったっけな」";
    "まあ、それも病気のせいなんだろな。";
    "帰りは下るだけ、それなら許せる...";
    pause 480ms;
    "坂を登って、トンネルを通って、私は学校にたどり着いた。";
    "インターホンを押す。";
    "「...」";
    "何も話していないのに、ドアのロックが開く音がした。";
    "また坂を登り、校舎につく。";
    "実習棟の方から、金属を削る甲高い音が聞こえた。";
    "職員専用の入口から入って、職員室に行く。";
    "ノックをする。";
    "ガラガラ、と音がして、担任の先生？がたくさんの配布物と、大事な書類を渡す。";
    "「ロッカーに残ってる荷物も持っていって」";
    "...これだけじゃないのか。";
    "重いなぁ...";
    pause 480ms;
    "職員室を出て、階段を登る。私の教室は最上階だ。";
    "手すりにつかまって息を整えながら、教室へたどり着く。";
    "ロッカーに残っていた教科書を、手提げへ押し込んだ。";
    "立ったまま息を整えているところを先生に見つかり、" +;
    "保健室で休んでから帰るように言われた。";
    pause 0ms;
    background asset("#284b59") with fade(360ms);
    stage school;
    wait 360ms;
    clear dialogue;
    screen interlude;
    narrate "9月18日　学校の保健室　昼休み";
    wait 1000ms;
    screen dialogue;
    clear dialogue;
    wait 220ms;
    "昼休みのチャイムが鳴る。";
    "廊下が一気に騒がしくなる。";
    "退学に必要な書類を受け取りに来ただけだった。";
    "担任は昼休みまで戻らないらしい。";
    "教室で待つ気にはなれず、保健室のカーテンを引いて、空いているベッドへ入った。";
    "先生は何も聞かなかった。";
    "俺が授業へ出ないことには、もう慣れていた。";
    "保健室のベッドを使うのは、初めてだった。";
    "横になる気にもなれず、毛布をどけて端に座った。";
    "床を見る。";
    "何かあるわけでもない。ただ、そこしか見られなかった。";
    "ズボンのポケットで、オイルライターの角が腿に当たった。";
    "取り出すのも面倒で、そのままにした。";
    "...";
    pause 0ms;
    wait 620ms;
    "いつの間にか、時間だけが過ぎていた。";
    "頭に血が上って、気持ち悪い。";
    "顔を上げる。";
    "目の前に、顔色の悪い女子が立っていた。";
    "「……健康なくせに、そんなところでサボってるの？」";
    "久しぶりに学校に来たという、難病を抱えたクラスメイト。";
    "ミオだった。";
    "「うるせえな。お前には関係ないだろ」";
    "「……贅沢な悩み。いらないなら、その身体、私に頂戴」";
    "「人の身体を勝手に欲しがるな」";
    "「いらないんでしょ」";
    "ミオは俺の返事も待たず、窓際の椅子に腰を下ろした。";
    "膝の上で、一冊のノートを開く。";
    "横から、びっしりと書き込まれた文字が見えた。";
    "駅の名前。時刻。金額。";
    "知らない地名ばかりだった。";
    "「何だ、それ」";
    "「別に」";
    "「駅名ばっかじゃねえか」";
    "「見ないで」";
    "ミオはノートを閉じ、俺から隠すように胸へ抱え込んだ。";
    "そのまま何度か咳き込む。";
    "廊下から、保健室の先生が顔を覗かせた。";
    "「迎え、来たみたいよ」";
    "「……分かりました」";
    "ミオはノートへ一度目を落とした。";
    "それから、俺が座っていたベッドの上へ置き、ゆっくりと立ち上がる。";
    "「じゃあ」";
    "「……ああ」";
    "保健室のドアが閉まった。";
    pause 0ms;
    wait 960ms;
    "少しして、ベッドの上に残されたノートへ目をやる。";
    "「忘れてんじゃねえか」";
    "追いかける気にはなれなかった。";
    "そのうち返せばいい。";
    "ノートを拾い上げる。";
    "表紙には、何も書かれていない。";
    "最初のページを開いた。";
    "九月二十一日、午前六時。横浜駅。";
    "その下には、列車の時刻と乗り換える駅が、細かく並んでいた。";
    "ページを捲っても、また駅名。";
    "西へ、西へ。";
    "最後の行には、海、とだけ書かれていた。";
    pause 0ms;
    wait 760ms;
    "俺はノートを閉じ、自分の鞄の底へ押し込んだ。";
    pause 0ms;
    screen interlude;
    narrate "9月20日　学校　朝";
    wait 1000ms;
    screen dialogue;
    clear dialogue;
    wait 220ms;
    "退学届を出すには、少し早く着きすぎた。";
    "鞄の底には、親の署名が入った退学届と、あのノートが入っている。";
    "ちゃちゃっと返してしまいたかった。";
    "持っていても、邪魔だしな。";
    "教室を順に覗く。";
    "塾のワークとにらめっこをしているやつが、数人いるだけだった。";
    "ミオはいない。";
    "探すのをやめ、最上階まで階段を上る。";
    "実習棟から、金属を削る音がまた聞こえた。";
    "一学期は毎週聞いていた音だった。";
    "足は止まらなかった。";
    "その先にある屋上の扉へ手をかけた。";
    "開かない。";
    "取っ手を、何度か揺らす。";
    "金属音が階段に響いた。";
    "後ろで、足音が止まった。";
    "「誰だ」";
    "振り向くと、手提げを持ったミオが立っていた。";
    "「...今って授業中だよね。ここで何してるの？」";
    "「屋上、行こうとしてるんだ」";
    "「開かないの？」";
    "「鍵、かかってるみたい」";
    "「...開けようと思わないの？」";
    "「...思う」";
    "ミオは手提げを足元に置いた。";
    "「じゃあ、手伝うよ」";
    "「どうやってやるのさ」";
    "「...どうしたらいいんだろうね」";
    "「押してみる？　それとも引いてみる？」";
    "「押してみよ」";
    "二人で、扉に体当たりをした。";
    "重い金属音が、階段に反響する。";
    "「開かない...」";
    "二度目。";
    "金属が裂けるような音がして、扉が急に外へ開いた。";
    "支えを失い、俺たちはそのまま屋上へ転がり込んだ。";
    "足元に、錆びたねじが跳ねた。";
    "南京錠は、掛け金に付いたままだった。";
    "「...開いた」";
    "「壊れた、でしょ」";
    "「まあ、そうとも言う...」";
    "ミオは立ち上がり、そのまま屋上へ出た。";
    "俺も後を追う。";
    "屋上には、枯れ葉が舞い散っていた。";
    "校庭では、サッカーをやっている。";
    "そんな景色を、フェンス越しに見る。";
    "「風が...やばいね」";
    "風が吹く。";
    "何度も、何度も。";
    "砂と落ち葉を巻き込み、俺の髪をなびかせる。";
    "鞄の底から、ノートを取り出した。";
    "「これ」";
    "ミオは表紙を見て、それから俺を見た。";
    "「...見たの？」";
    "「見えた」";
    "ミオはノートを受け取り、手提げにしまった。";
    "「明日、六時」";
    "「知ってる」";
    "「そっか」";
    "また、風が吹いた。";
    "「ねえ」";
    "「本、好き？」";
    "ミオは手提げから、一冊の文庫本を取り出した。";
    "「よだかの星。面白いよ...」";
    "俺は文庫本を受け取った。";
    pause 0ms;
    wait 560ms;
    "ミオと別れ、職員室へ戻った。";
    "親の署名が入った退学届を、担任へ渡す。";
    "担任は書類へ目を落とし、それから俺を見た。";
    "「本当に、これでいいんだな」";
    "「ああ」";
    "担任は退学届を、机の端へ置いた。";
    pause 0ms;
    background asset("#6d706f") with fade_through_black(640ms);
    stage stillness;
    wait 640ms;
    "家に帰る。";
    "相変わらず、白い壁と、重たい勉強机が俺を待っている。";
    "鞄から『よだかの星』を取り出し、机の端に置いた。";
    "その横には、山のように積まれた課題と教材。";
    "一番上に、通信制高校のパンフレットが置かれていた。";
    pause 0ms;
    screen statement;
    background asset("#05070b") with fade(260ms);
    stage blackout;
    narrate "俺には優秀な兄がいた。";
    wait 1600ms;
    background asset("#6d706f") with fade(360ms);
    stage stillness;
    screen dialogue;
    clear dialogue;
    wait 180ms;
    "「お兄ちゃんはできたのに」";
    "「どうして君にはできないんだ」";
    "椅子に座る。";
    "少し、息が浅くなった。";
    "九月二十一日、午前六時。横浜駅。";
    "...明日の朝か。";
    "あんなやつが、本当に行くんだろうか。あの顔で、一人でさ。";
    "机の引き出しを開ける。";
    "親が置いていった、茶封筒。";
    "通信制高校へ入り直すための金だと聞かされていた。";
    "中身は、十万円。";
    "俺はそれを取り出した。";
    "一度、引き出しへ戻した。";
    "それから、もう一度取り出して、鞄の底へ押し込んだ。";
    "あいつを止めに行くわけではない。";
    "ただ、この息の詰まる部屋から抜け出すための、言い訳が欲しかっただけ、なんだろう。";
    pause 0ms;
    wait 1200ms;
    chapter "canonical_chapter_00" progress 100;
    clear dialogue;
    background asset("#05070b") with fade(480ms);
    stage blackout;
    wait 480ms;
    jump chapter_select_ja;
  }
}
